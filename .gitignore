# Python
__pycache__/
*.pyc
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/

# PyInstaller freeze build outputs (packaging/freeze_cli.sh) — sizable,
# machine-local; the frozen CLI is embedded into the DMG, never tracked.
/build-freeze/
/build-freeze-cache/
/dist-freeze/

# macOS
.DS_Store

# Swift / capture
capture/.build/
capture/.tmp/
capture/.modcache/
capture/.swiftpm-cache/

# Swift / menu-bar
menu-bar/.build/
menu-bar/.tmp/
menu-bar/.modcache/
menu-bar/.swiftpm-cache/

# Runtime / daemon artifacts (e.g. nohup.out from launching helpers/apps)
nohup.out
*.out
*.log

# Phase-0 spike — archived out of the repo (see meeting-recorder-archive/ sibling).
# `/spike/` is ignored so no spike artifact ever gets tracked again.
/spike/

# Internal developer-only docs (task briefs, backlog, checkpoints, manual-test
# writeups). Kept on disk for development but not shipped to the public repo;
# only the user-facing docs under docs/ are tracked.
/developers/

# demo outputs
examples/demo/output/